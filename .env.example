# Runtime environment
RUNTIME_ENVIRONMENT=development

# Database connections
MASTER_ROUTER_DB_URL=postgresql+asyncpg://user:password@localhost:5432/fugu_master
METADATA_SIDEBAR_DB_URL=postgresql+asyncpg://user:password@localhost:5432/fugu_metadata
TRANSACTIONAL_LOGS_DB_URL=postgresql+asyncpg://user:password@localhost:5432/fugu_transactional

# Authentication and encryption
SYSTEM_SESSION_SECRET=
VAULT_ENCRYPTION_KEY=
JWT_ISSUER=fugu-kernel-core
JWT_AUDIENCE=fugu-studio-client
ACCESS_TOKEN_TTL_MINUTES=30

# Database pool and readiness controls
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=20
NETWORK_REQUEST_TIMEOUT=45.0
HEALTH_CHECK_TIMEOUT_SECONDS=3.0
VERIFY_DATABASES_ON_STARTUP=true

# Serialized migration controls
MIGRATION_LOCK_ID=726846354297
MIGRATION_LOCK_TIMEOUT_SECONDS=120.0
RUN_MIGRATIONS=true

# Comma-separated exact frontend origins. Production origins must use HTTPS.
ALLOWED_ORIGINS=http://localhost:3000
CORS_PREFLIGHT_MAX_AGE_SECONDS=600

# ASGI runtime controls
WEB_WORKERS_COUNT=2
SERVER_BIND_HOST=0.0.0.0
SERVER_BIND_PORT=8000
SERVER_KEEP_ALIVE_SECONDS=5
SERVER_GRACEFUL_SHUTDOWN_SECONDS=30
SERVER_LOG_LEVEL=info

# Enable only behind a trusted reverse proxy and restrict forwarded addresses.
TRUST_PROXY_HEADERS=false
FORWARDED_ALLOW_IPS=127.0.0.1

# Frontend build/runtime API origin
NEXT_PUBLIC_FUGU_API_BASE_URL=http://localhost:8000
