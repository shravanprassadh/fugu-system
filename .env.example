# Database connections
MASTER_ROUTER_DB_URL=postgresql+asyncpg://user:password@localhost:5432/fugu_master
METADATA_SIDEBAR_DB_URL=postgresql+asyncpg://user:password@localhost:5432/fugu_metadata
TRANSACTIONAL_LOGS_DB_URL=postgresql+asyncpg://user:password@localhost:5432/fugu_transactional

# Authentication and encryption
ADMIN_ACCESS_PASSPHRASE=
SYSTEM_SESSION_SECRET=
VAULT_ENCRYPTION_KEY=

# Database pool limits
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=20
NETWORK_REQUEST_TIMEOUT=45.0

# Comma-separated trusted frontend origins
ALLOWED_ORIGINS=http://localhost:3000
